    <string name="settings_store_title">Engine store</string>
    <string name="settings_store">The engine keeps its state, the applied settings, the installed fingerprint, the previous keybox and the copy of itself that the boot hook runs in %1$s.</string>
    <string name="settings_capabilities">Root capabilities</string>
