    <string name="settings_behavior">Applying</string>
    <string name="settings_restart_on_change">Restart the keystore on changes</string>
    <string name="settings_restart_on_change_help">A new keybox or fingerprint takes effect at once: the keystore daemon restarts, and Play services and the Play Store are ended. Otherwise changes take effect at the next reboot.</string>
    <string name="settings_restart_now">Restart the keystore now</string>
    <string name="settings_restart_now_help">Reloads the keybox and the per-app keys, and ends Play services and the Play Store.</string>
